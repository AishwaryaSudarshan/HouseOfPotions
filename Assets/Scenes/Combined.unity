--- !u!114 &455876867
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 455876865}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Game Instructions:  \n \u2022 When you start the game, your wand will
    appear with a raycast to guide you.  \n \u2022 A potion recipe will appear in
    the leftmost corner of the screen to follow.  \n \u2022 All interactable objects
    are outlined in <color=red>red</color>.  \n \u2022 When you hover over an object,
    it turns <color=yellow>yellow</color> to indicate that it\u2019s selected.  \n
    \u2022 Click <color=purple>\u201CX\u201D</color> to store ingredients from the
    different rooms.  \n \u2022 Once all necessary ingredients are collected, go
    to the Alchemy Room.  \n \u2022 Hover over the pot, open your inventory by clicking
    <color=purple>\u201COK\u201D</color>, and toggle through items with your joystick. 
    \n \u2022 Once you\u2019ve made your selection, click <color=purple>\u201CB\u201D</color>
    to grab it.  \n \u2022 Make sure your raycast is pointing inside the pot and
    click <color=purple>\u201CA\u201D</color> to drop the item. (Look for the pot
    bubble!)  \n \u2022 Keep adding ingredients until the potion is complete. You\u2019ll
    know it worked when the room looks magical.  \n\u2022 Potion bottles to throw
    at the rooms will appear on the table next to the pot. Click <color=purple>\u201CX\u201D</color>
    to store them in your inventory.  \n \u2022 As you enter each room that needs
    fixing, open your inventory and click <color=purple>\u201CB\u201D</color> to
    grab a bottle.  \n \u2022 Turn your head <color=blue>left\u2192right\u2192left</color>
    to cast the spell and fix the room.  \n \u2022 Return to the Alchemy Room to
    grab more bottles and fix the rest of the house.  \n \u2022 Fix the entire house
    before <color=orange>time runs out</color>!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
